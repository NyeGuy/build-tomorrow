---
import home from '../../content/home.json';
---

<aside class="goal-strip" aria-label="Campaign goal">
  <div class="wrap goal-strip__inner">
    <p class="goal-strip__eyebrow">{home.goal.eyebrow}</p>
    <p class="goal-strip__line">
      <strong>{home.goal.amount}</strong>
      <span>{home.goal.by}</span>
    </p>
  </div>
</aside>
