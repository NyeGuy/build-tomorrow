---
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaBracket from '../components/MediaBracket.astro';
import WhiteButton from '../components/WhiteButton.astro';
import home from '../../content/home.json';
import site from '../../content/site.json';
import { fundUrl } from '../lib/funds';
import { withBase } from '../lib/paths';
---

<BaseLayout title={`${home.hero.headline} — ${site.school} Fundraising`}>
  <section class="band hero">
    <div class="wrap hero__grid">
      <div>
        <p class="eyebrow">{home.hero.eyebrow}</p>
        <h1>{home.hero.headline}</h1>
        <p class="lead">{home.hero.lead}</p>
        <div class="cta-row">
          <WhiteButton href={fundUrl('TECH_FUND_URL')} external>
            Give to the Technology Fund
          </WhiteButton>
          <WhiteButton href={fundUrl('DT_FUND_URL')} external>
            Give to Design Tomorrow
          </WhiteButton>
        </div>
      </div>
      <MediaBracket label={home.hero.photo.bracket} caption={home.hero.photo.caption} ratio="5 / 4" />
    </div>
  </section>

  <section class="band band--raised">
    <div class="wrap">
      <p class="eyebrow">{home.ways.eyebrow}</p>
      <h2>{home.ways.headline}</h2>
      <ol class="way-grid">
        {
          home.ways.items.map((way) => (
            <li class="way-card">
              <p class="way-card__kicker">{way.kicker}</p>
              <h3>{way.title}</h3>
              <p>{way.body}</p>
              <div class="cta-row">
                {way.fund ? (
                  <WhiteButton href={fundUrl(way.fund)} external>
                    {way.cta}
                  </WhiteButton>
                ) : (
                  <WhiteButton href={withBase(way.page)}>{way.cta}</WhiteButton>
                )}
                {way.fund ? (
                  <a class="text-link" href={withBase(way.page)}>
                    Read more
                  </a>
                ) : null}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>
